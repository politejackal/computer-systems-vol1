#!/usr/bin/exec-suid -- /usr/bin/python3 -I

import random
import sys

ROUNDS = [4, 4, 4, 8, 8, 8]

for bits in ROUNDS:
    value = random.randint(1, 2**bits - 1)
    print(f"{value:0{bits}b}")
    try:
        answer = int(input("Decimal: ").strip())
    except (ValueError, EOFError):
        print("Wrong.")
        sys.exit(1)
    if answer != value:
        print("Wrong.")
        sys.exit(1)

print(open("/flag").read().strip())
